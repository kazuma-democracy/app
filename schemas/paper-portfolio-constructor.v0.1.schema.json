{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wa-commons.example/schemas/paper-portfolio-constructor.v0.1.schema.json",
  "title": "WA Commons Paper Portfolio Constructor v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "constructor_id",
    "constructor_version",
    "objective",
    "preference",
    "constraints",
    "identity",
    "decision_semantics",
    "solver",
    "numerical",
    "paper_only"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "constructor_id": {"const": "benchmark-l2-projection"},
    "constructor_version": {"const": "0.1"},
    "objective": {"const": "l2_distance_to_policy_adjusted_benchmark"},
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregation", "tilt_strength", "score_min", "score_max"],
      "properties": {
        "aggregation": {"const": "unique_rule_signed_sum_clamp"},
        "tilt_strength": {"const": 0.5},
        "score_min": {"const": -1.0},
        "score_max": {"const": 1.0}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["long_only", "fully_invested", "max_single_name_weight", "exclude_weight"],
      "properties": {
        "long_only": {"const": true},
        "fully_invested": {"const": true},
        "max_single_name_weight": {"const": 0.1},
        "exclude_weight": {"const": 0.0}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unmapped_behavior", "disputed_behavior"],
      "properties": {
        "unmapped_behavior": {"const": "retain_unscreened_no_tilt"},
        "disputed_behavior": {"const": "fail_closed"}
      }
    },
    "decision_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watch_behavior", "none_behavior", "none_is_pass"],
      "properties": {
        "watch_behavior": {"const": "eligible_no_automatic_tilt"},
        "none_behavior": {"const": "eligible_no_automatic_tilt"},
        "none_is_pass": {"const": false}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library",
        "library_version",
        "name",
        "python_package_version",
        "warm_start",
        "eps_abs",
        "eps_rel",
        "max_iter",
        "polishing",
        "adaptive_rho"
      ],
      "properties": {
        "library": {"const": "cvxpy"},
        "library_version": {"const": "1.9.2"},
        "name": {"const": "OSQP"},
        "python_package_version": {"const": "1.1.3"},
        "warm_start": {"const": false},
        "eps_abs": {"const": 1e-8},
        "eps_rel": {"const": 1e-8},
        "max_iter": {"const": 100000},
        "polishing": {"const": true},
        "adaptive_rho": {"const": false}
      }
    },
    "numerical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_weight_tolerance",
        "feasibility_tolerance",
        "output_invariant_tolerance",
        "semantic_weight_decimals",
        "rounding_mode"
      ],
      "properties": {
        "input_weight_tolerance": {"const": 1e-8},
        "feasibility_tolerance": {"const": 1e-10},
        "output_invariant_tolerance": {"const": 1e-8},
        "semantic_weight_decimals": {"const": 12},
        "rounding_mode": {"const": "ROUND_HALF_EVEN"}
      }
    },
    "paper_only": {"const": true}
  }
}
